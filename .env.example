# LLM generation is optional. Without a configured provider the API returns a cited extractive answer.
LLM_PROVIDER=grok
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# To use Grok instead, set LLM_PROVIDER=grok and add an xAI API key.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Groq is a separate provider from xAI/Grok. It uses keys that typically start with gsk_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ENABLE_WEB_FALLBACK=true

RAG_DATA_DIR=./data
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_DENSE_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_RERANK_CANDIDATES=10
RAG_MAX_CRAWL_PAGES=25
RAG_REQUEST_TIMEOUT_SECONDS=20
